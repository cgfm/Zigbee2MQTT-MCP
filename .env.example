MQTT_BROKER_URL=mqtt://mqtt:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=zigbee2mqtt
TRANSPORT_MODE=http
HTTP_HOST=0.0.0.0
HTTP_PORT=3235
API_KEY=replace-with-a-random-token-of-at-least-24-characters
ALLOWED_ORIGINS=
SSL_ENABLED=false
SSL_CERTFILE=/ssl/fullchain.pem
SSL_KEYFILE=/ssl/privkey.pem
MAX_SESSIONS=32
ALLOW_DESTRUCTIVE=false
LOG_LEVEL=info
